#!/usr/bin/env python3
import sys

def main():
    # Minimal wrapper to avoid incompatible esp_idf_size being called by PlatformIO.
    # Accept any args and exit successfully. Print a short notice so logs show it's the wrapper.
    try:
        # Show which file would have been processed, if provided
        if len(sys.argv) > 1:
            print("esp_idf_size wrapper: skipping size check for", sys.argv[-1])
        else:
            print("esp_idf_size wrapper: skipping size check")
    except Exception:
        pass
    return 0

if __name__ == '__main__':
    sys.exit(main())
