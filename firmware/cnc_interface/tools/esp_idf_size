#!/usr/bin/env python3
import sys
import os
import shutil
import subprocess

def find_real_esp_idf_size(self_path):
    # Search PATH for an esp_idf_size executable that is not this wrapper
    paths = os.environ.get('PATH', '').split(os.pathsep)
    for p in paths:
        candidate = os.path.join(p, 'esp_idf_size')
        try:
            if os.path.exists(candidate):
                cand_real = os.path.realpath(candidate)
                if cand_real != os.path.realpath(self_path) and os.access(candidate, os.X_OK):
                    return candidate
        except Exception:
            continue
    return None

def main():
    # Accept and ignore legacy/unsupported args like --ng, but forward other args
    argv = sys.argv[1:]
    cleaned = [a for a in argv if a != '--ng']

    self_path = os.path.realpath(__file__)
    real = find_real_esp_idf_size(self_path)
    if real:
        try:
            # Call the real esp_idf_size with cleaned args
            rc = subprocess.call([real] + cleaned)
            return rc
        except Exception as e:
            print("esp_idf_size wrapper: failed to run real tool:", e)
            # fallthrough to wrapper behavior

    # No real tool found or it failed — behave as a no-op wrapper
    try:
        if cleaned:
            print("esp_idf_size wrapper: skipping size check for", cleaned[-1])
        else:
            print("esp_idf_size wrapper: skipping size check")
    except Exception:
        pass
    return 0

if __name__ == '__main__':
    sys.exit(main())
